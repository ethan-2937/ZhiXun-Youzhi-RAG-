    "harness/rag-evaluation/dataset.schema.json",
    "harness/rag-evaluation/prediction.schema.json",
    "harness/rag-evaluation/dataset.sample.jsonl",
    "harness/rag-evaluation/predictions.sample.jsonl",
    "harness/retrieval-evaluation/dataset.schema.json",
    "harness/retrieval-evaluation/prediction.schema.json",
    "harness/retrieval-evaluation/dataset.sample.jsonl",
    "harness/retrieval-evaluation/predictions.sample.jsonl",
