    "scripts/collect_retrieval_predictions.py",
    "scripts/import_knowledge.py",
    "scripts/publish.ps1",
    "scripts/rag_eval.py",
    "scripts/retrieval_eval.py",
    "scripts/verify.ps1",
    "tests/test_check_harness.py",
    "tests/test_collect_retrieval_predictions.py",
    "tests/test_import_knowledge.py",
    "tests/test_rag_eval.py",
    ".github/workflows/ci.yml"
  ],
  "sensitiveTrackedPrefixes": [
    ".env",
    "config/.env",
    "data/",
    "uploads/",
    "logs/",
    "tmp/",
    "harness/rag-evaluation/runs/",
    "harness/retrieval-evaluation/runs/"
  ],
  "forbiddenControllerImports": [
    "repository",
    "mapper",
    "service.impl",
    "vectorstore",
    "chatmodel"
  ],
  "ragEvaluation": {
    "dataset": "harness/rag-evaluation/dataset.sample.jsonl",
    "samplePredictions": "harness/rag-evaluation/predictions.sample.jsonl",
    "thresholds": {
      "caseCoverage": 1.0,
      "answerabilityAccuracy": 1.0,
      "requiredDocumentRecall": 1.0,
      "forbiddenDocumentLeakRate": 0.0,
      "requiredTermCoverage": 1.0,
      "forbiddenTermLeakRate": 0.0,
      "maxP95LatencyMs": 5000
    }
  },
  "retrievalEvaluation": {
    "dataset": "harness/retrieval-evaluation/dataset.sample.jsonl",
    "samplePredictions": "harness/retrieval-evaluation/predictions.sample.jsonl",
    "config": {
      "topK": 4,
      "minScore": 0.45
    },
    "thresholds": {
      "caseCoverage": 1.0,
      "answerabilityAccuracy": 1.0,
      "requiredDocumentRecallAtK": 1.0,
      "hitRateAtK": 1.0,
      "mrrAtK": 1.0,
      "ndcgAtK": 1.0,
      "maxForbiddenCandidateLeakRate": 0.0,
      "maxForbiddenSelectedLeakRate": 0.0,
      "maxDuplicateDocumentRate": 0.0,
      "maxP95LatencyMs": 5000
    }
  }
}
