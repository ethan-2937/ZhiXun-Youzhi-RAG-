{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/youzhi-rag/prediction.schema.json",
  "title": "YuoZhi RAG prediction",
  "type": "object",
  "additionalProperties": false,
  "required": ["caseId", "status", "answer", "citations", "latencyMs"],
  "properties": {
    "caseId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
    },
    "status": {
      "type": "string",
      "enum": ["answered", "insufficient", "refused"]
    },
    "answer": {
      "type": "string",
      "maxLength": 12000
    },
    "citations": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["documentId", "chunkId"],
        "properties": {
          "documentId": {"type": "string", "pattern": "^doc-test-[a-z0-9-]+$"},
          "chunkId": {"type": "string", "minLength": 1, "maxLength": 128}
        }
      }
    },
    "latencyMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 300000
    }
  }
}
