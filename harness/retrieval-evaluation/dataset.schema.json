{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/youzhi-rag/retrieval-dataset.schema.json",
  "title": "YuoZhi retrieval evaluation case",
  "type": "object",
  "additionalProperties": false,
  "required": ["caseId", "question", "principal", "scope", "expected"],
  "properties": {
    "caseId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "question": {"type": "string", "minLength": 2, "maxLength": 1000},
    "principal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["userId"],
      "properties": {"userId": {"type": "string", "pattern": "^test-user-[a-z0-9-]+$"}}
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spaceId"],
      "properties": {"spaceId": {"type": ["string", "null"], "maxLength": 64}}
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["answerable", "requiredDocumentIds", "forbiddenDocumentIds"],
      "properties": {
        "answerable": {"type": "boolean"},
        "requiredDocumentIds": {
          "type": "array", "maxItems": 20, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^doc-test-[a-z0-9-]+$"}
        },
        "forbiddenDocumentIds": {
          "type": "array", "maxItems": 20, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^doc-test-[a-z0-9-]+$"}
        }
      }
    }
  }
}
