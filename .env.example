# Local leadership demo. The backend defaults to this mode when unset.
APP_AUTH_MODE=demo
APP_SESSION_COOKIE_SECURE=false
APP_BIND_ADDRESS=127.0.0.1
APP_HTTP_PORT=18080
APP_SESSION_TIMEOUT=8h
IMAGE_TAG=local
BACKEND_MEMORY_LIMIT=768m
FRONTEND_MEMORY_LIMIT=128m

# Optional real semantic retrieval. Keep disabled until an approved JSONL export is mounted.
RAG_ENABLED=false
EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=8
EMBEDDING_MAX_INPUT_CHARS=1600

# Optional bounded Agentic RAG. Chat credentials default to the Embedding gateway values.
AGENTIC_RAG_ENABLED=false
CHAT_BASE_URL=http://127.0.0.1:11434/v1
CHAT_API_KEY=
CHAT_MODEL=qwen-plus
CHAT_CONNECT_TIMEOUT=3s
CHAT_READ_TIMEOUT=60s
CHAT_MAX_REQUEST_CHARS=20000
CHAT_MAX_RESPONSE_CHARS=12000
CHAT_MAX_OUTPUT_TOKENS=800
AGENT_MAX_QUERIES=3
AGENT_MAX_ROUNDS=2
AGENT_MAX_QUERY_CHARS=500
AGENT_CANDIDATE_TOP_K=8
AGENT_MIN_SCORE=0.30
AGENT_MAX_EVIDENCE=6
AGENT_MAX_CONTEXT_CHARS=8000
AGENT_MAX_CONTEXT_TOKENS=6000
AGENT_MAX_ANSWER_CHARS=4000
RAG_KNOWLEDGE_FILE=/knowledge/documents.jsonl
RAG_RAW_DIRECTORY=/knowledge/raw
RAG_MAX_RAW_FILE_BYTES=52428800
RAG_MAX_PREVIEW_CHARS=50000
RAG_CHUNK_CHARS=1200
RAG_CHUNK_OVERLAP_CHARS=120

# Local-only retrieval evaluation endpoint. Never enable it in production.
RAG_DIAGNOSTICS_ENABLED=false
RAG_DIAGNOSTICS_MAX_CANDIDATES=50

# DingTalk in-app login. Never commit real values.
DINGTALK_CORP_ID=
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_AUTH_CODE_REPLAY_TTL=5m

# Production must use HTTPS and secure session cookies.
# APP_AUTH_MODE=dingtalk
# APP_SESSION_COOKIE_SECURE=true
# APP_BIND_ADDRESS=127.0.0.1
