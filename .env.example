# Local leadership demo. The backend defaults to this mode when unset.
APP_AUTH_MODE=demo
APP_SESSION_COOKIE_SECURE=false
APP_BIND_ADDRESS=127.0.0.1
APP_HTTP_PORT=18080
APP_SESSION_TIMEOUT=8h
IMAGE_TAG=local
BACKEND_MEMORY_LIMIT=768m
FRONTEND_MEMORY_LIMIT=128m

# Optional real semantic retrieval. Keep disabled until an approved JSONL export is mounted.
RAG_ENABLED=false
EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=8
EMBEDDING_MAX_INPUT_CHARS=1600
RAG_KNOWLEDGE_FILE=/knowledge/documents.jsonl
RAG_RAW_DIRECTORY=/knowledge/raw
RAG_MAX_RAW_FILE_BYTES=52428800
RAG_MAX_PREVIEW_CHARS=50000
RAG_CHUNK_CHARS=1200
RAG_CHUNK_OVERLAP_CHARS=120

# DingTalk in-app login. Never commit real values.
DINGTALK_CORP_ID=
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_AUTH_CODE_REPLAY_TTL=5m

# Production must use HTTPS and secure session cookies.
# APP_AUTH_MODE=dingtalk
# APP_SESSION_COOKIE_SECURE=true
# APP_BIND_ADDRESS=127.0.0.1
